#!/bin/bash
# The hook of git that holds a commit of SMS++ to its style: the files of the
# commit are checked with smspp-format --check --git (in a C++ source only
# the lines changed since HEAD, a configuration whole), and the commit stops
# if one is not in the style, saying how to put it there. It is installed in
# the umbrella and in every submodule by scripts/install-hooks; git commit
# --no-verify commits all the same.

# the umbrella: this repository, the one it is a submodule of, or $SMSPP_ROOT
top=$(git rev-parse --show-toplevel)
root=$(git rev-parse --show-superproject-working-tree 2>/dev/null)
[ -x "$top/scripts/smspp-format" ] && root=$top
[ -n "$SMSPP_ROOT" ] && root=$SMSPP_ROOT
fmt=$root/scripts/smspp-format
if [ ! -x "$fmt" ] ; then
  echo "pre-commit: no scripts/smspp-format of the umbrella, style not" \
       "checked (set SMSPP_ROOT)" >&2
  exit 0
fi
if ! command -v clang-format > /dev/null ; then
  echo "pre-commit: no clang-format, style not checked" \
       "(pip install clang-format==22.1.5)" >&2
  exit 0
fi

files=()
while IFS= read -r f ; do
  case "$f" in
    *.h|*.hh|*.hpp|*.c|*.cc|*.cpp|*.cxx|*.inc) files+=("$f") ;;
    *.txt) grep -q '^# - - - - -' "$f" 2>/dev/null && files+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=AMR)
[ ${#files[@]} = 0 ] && exit 0

cd "$top" || exit 0
bad=$("$fmt" --check --git "${files[@]}")
if [ -n "$bad" ] ; then
  echo "These files are not in the style of SMS++:" >&2
  echo "$bad" >&2
  echo "Put them in it with" >&2
  echo "  $fmt --git $(echo $bad)" >&2
  echo "and add them again, or commit with --no-verify." >&2
  exit 1
fi
exit 0
