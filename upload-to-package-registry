#!/usr/bin/env bash

# --------------------------------------------------------------------------- #
# Script to upload a file to GitLab Package Registry, as a given version      #
#                                                                             #
# Prerequisites:                                                              #
#   Generate a GitLab Personal Access Token (PAT) with the `api` scope at:    #
#     https://gitlab.com/-/user_settings/personal_access_tokens               #
#                                                                             #
#   You can configure the token in two ways:                                  #
#                                                                             #
#   Option 1: Setting GITLAB_TOKEN env var (temporary)                        #
#                                                                             #
#          $ export GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx                   #
#                                                                             #
#   Option 2: Using `glab` (GitLab CLI, permanent) from your git repo         #
#                                                                             #
#          $ glab auth login                                                  #
#          $ glab config set token glpat-xxxxxxxxxxxxxxxxxxxx                 #
#                                                                             #
# This script will try to read the token from glab automatically if           #
# GITLAB_TOKEN is not set.                                                    #
#                                                                             #
# Usage:                                                                      #
#                                                                             #
#          $ bash upload-to-package-registry <path/to/your-file> <version>    #
#                                                                             #
# The version is the one the CMakeLists.txt of the module downloads (its      #
# DATA_VERSION), and the data/upload-* script of the module passes it. A      #
# published version is never replaced, so that whoever has downloaded it     #
# keeps the same data: new data need a new version, and the script refuses    #
# one that is already there. The same file also replaces `latest`, which is   #
# what the modules that do not name a version yet still download.             #
#                                                                             #
#                                Donato Meoli                                 #
#                         Dipartimento di Informatica                         #
#                             Universita' di Pisa                             #
# --------------------------------------------------------------------------- #

set -e

# Check arguments
if [[ $# -ne 2 || -z "$2" ]]; then
  echo "Usage: $0 <file_to_upload> <version>"
  exit 1
fi

LOCAL_FILE="$1"
VERSION="$2"

if [[ "$VERSION" == "latest" ]]; then
  echo "ERROR: 'latest' is written together with every version, not by itself."
  exit 1
fi

if [[ ! -f "$LOCAL_FILE" ]]; then
  echo "ERROR: File '$LOCAL_FILE' not found."
  exit 1
fi

# Extract project name from path (first folder, lowercase)
PROJECT_DIR=$(echo "$LOCAL_FILE" | cut -d'/' -f1 | tr '[:upper:]' '[:lower:]')
PROJECT_PATH="smspp/$PROJECT_DIR"
ENCODED_PATH=$(echo -n "$PROJECT_PATH" | sed 's/\//%2F/g')

# Extract filename from path
FILE_NAME=$(basename "$LOCAL_FILE")
# Remove extensions for package name
PACKAGE_NAME=$(echo "$FILE_NAME" | sed -E 's/(\.[a-zA-Z0-9]+)+$//')

# Try to load token from env or glab config
if [[ -z "$GITLAB_TOKEN" ]]; then
  if command -v glab &> /dev/null; then
    GITLAB_TOKEN=$(glab config get token 2>/dev/null | head -n1)
  fi
fi

if [[ -z "$GITLAB_TOKEN" ]]; then
  echo "ERROR: GITLAB_TOKEN is not set and not found in glab config."
  echo "You must either:"
  echo "  1. export GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx"
  echo "  2. or configure glab with: glab config set token glpat-xxxxxxxxxxxxxxxxxxxx"
  exit 1
fi

PROJECT_ID=$(curl -s --header "PRIVATE-TOKEN: $GITLAB_TOKEN" \
  "https://gitlab.com/api/v4/projects/$ENCODED_PATH" | jq -r .id)

if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "null" ]]; then
  echo "ERROR: Failed to retrieve PROJECT_ID for '$PROJECT_PATH'"
  exit 1
fi

# The id of the package named $PACKAGE_NAME with the given version, if any
package_id() {
  curl -s --fail --header "PRIVATE-TOKEN: $GITLAB_TOKEN" \
    "https://gitlab.com/api/v4/projects/$PROJECT_ID/packages?package_type=generic&package_name=$PACKAGE_NAME&per_page=100" \
    | jq -r ".[] | select(.name==\"$PACKAGE_NAME\" and .version==\"$1\") | .id"
}

upload() {
  local url="https://gitlab.com/api/v4/projects/$PROJECT_ID/packages/generic/$PACKAGE_NAME/$1/$FILE_NAME"
  echo "Uploading $LOCAL_FILE as version '$1'..."
  curl -s --fail --header "PRIVATE-TOKEN: $GITLAB_TOKEN" \
       --upload-file "$LOCAL_FILE" "$url" > /dev/null
  echo "Download URL: $url"
}

# A published version is never replaced: whoever has downloaded it would keep
# data that no longer match the ones under the same name
if [[ -n "$(package_id "$VERSION")" ]]; then
  echo "ERROR: version '$VERSION' of '$PACKAGE_NAME' is already published and is"
  echo "never replaced: raise DATA_VERSION in the CMakeLists.txt of the module."
  exit 1
fi

upload "$VERSION"

# `latest` follows the newest version
EXISTING_ID=$(package_id latest)
if [[ -n "$EXISTING_ID" ]]; then
  curl -s --fail --request DELETE \
       --header "PRIVATE-TOKEN: $GITLAB_TOKEN" \
       "https://gitlab.com/api/v4/projects/$PROJECT_ID/packages/$EXISTING_ID"
fi
upload latest

echo "Upload complete."
