#!/bin/bash

# Function to install software on Ubuntu
install_on_ubuntu() {
  set -e # Exit immediately if a command exits with a non-zero status

  # Save the current directory
  local current_dir
  current_dir=$(pwd)

  echo "Starting the installation process on Ubuntu..."

  # Update packages and install basic requirements
  echo "Updating system and installing basic requirements..."
  sudo apt-get update
  sudo apt-get install -y build-essential cmake git

  # Install Boost libraries
  echo "Installing Boost libraries..."
  sudo apt-get install -y libboost-dev libboost-system-dev libboost-timer-dev libboost-mpi-dev libboost-random-dev

  # Install NetCDF-C++
  echo "Installing NetCDF-C++..."
  sudo apt-get install -y libnetcdf-c++4-dev

  # Install Eigen
  echo "Installing Eigen..."
  sudo apt-get install -y libeigen3-dev

  # Prepare to install Gurobi
  echo "Downloading and installing Gurobi..."
  cd /opt
  sudo wget https://packages.gurobi.com/10.0/gurobi10.0.3_linux64.tar.gz
  sudo tar -xvf gurobi10.0.3_linux64.tar.gz
  sudo rm gurobi10.0.3_linux64.tar.gz
  export GUROBI_HOME="/opt/gurobi/linux64"
  export PATH="${PATH}:${GUROBI_HOME}/bin"
  export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${GUROBI_HOME}/lib"
  sudo sh -c "echo '${GUROBI_HOME}/lib' > /etc/ld.so.conf.d/gurobi.conf"
  sudo ldconfig

  # Install SCIP
  echo "Installing SCIP..."
  sudo apt-get install -y gfortran libtbb-dev
  cd /opt
  sudo curl -O https://www.scipopt.org/download/release/SCIPOptSuite-9.0.0-Linux-ubuntu22.sh
  sudo chmod u+x SCIPOptSuite-9.0.0-Linux-ubuntu22.sh
  sudo ./SCIPOptSuite-9.0.0-Linux-ubuntu22.sh --prefix=/opt/scip --exclude-subdir --skip-license
  sudo rm SCIPOptSuite-9.0.0-Linux-ubuntu22.sh
  sudo sh -c "echo '/opt/scip/lib' > /etc/ld.so.conf.d/scip.conf"
  sudo ldconfig

  # Install HiGHS
  echo "Installing HiGHS..."
  sudo git clone https://github.com/ERGO-Code/HiGHS.git /opt/HiGHS
  cd /opt/HiGHS
  sudo mkdir build
  cd build
  sudo cmake -DFAST_BUILD=ON -DCMAKE_INSTALL_PREFIX=/opt/HiGHS ..
  sudo cmake --build .
  sudo cmake --install .
  sudo sh -c "echo '/opt/HiGHS/lib' > /etc/ld.so.conf.d/highs.conf"
  sudo ldconfig

  # Install COIN-OR CoinUtils and Osi/Clp
  echo "Installing COIN-OR CoinUtils and Osi/Clp..."
  sudo apt-get install -y coinor-libcoinutils-dev libbz2-dev liblapack-dev libopenblas-dev
  cd /opt
  sudo curl -O https://raw.githubusercontent.com/coin-or/coinbrew/master/coinbrew
  sudo chmod u+x coinbrew
  sudo ./coinbrew build CoinUtils --latest-release --skip-dependencies --prefix=/opt/coin-or --tests=none
  sudo ./coinbrew build Osi --latest-release --skip-dependencies --prefix=/opt/coin-or --tests=none --without-cplex --with-gurobi --with-gurobi-lib="-L$GUROBI_HOME/lib -lgurobi100" --with-gurobi-incdir="$GUROBI_HOME/include"
  sudo ./coinbrew build Clp --latest-release --skip-dependencies --prefix=/opt/coin-or --tests=none
  sudo rm coinbrew

  # Install StOpt
  echo "Installing StOpt..."
  sudo apt-get install -y zlib1g-dev
  sudo git clone https://gitlab.com/stochastic-control/StOpt /opt/StOpt
  cd /opt/StOpt
  sudo mkdir build
  cd build
  sudo cmake -DBUILD_PYTHON=OFF -DBUILD_TEST=OFF ..
  sudo cmake --build .
  sudo cmake --install . --prefix=/opt/stopt

  echo "Installation completed successfully on Ubuntu."

  # Return to the original directory
  cd "$current_dir"
}

# Function to install software on macOS
install_on_macos() {
  set -e # Exit immediately if a command exits with a non-zero status

  # Save the current directory
  local current_dir
  current_dir=$(pwd)

  echo "Starting the installation process on macOS..."

  # Install Xcode Command Line Tools
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install

  # Install Homebrew
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Install CMake
  echo "Installing CMake..."
  brew install cmake

  # Install Boost libraries
  echo "Installing Boost libraries..."
  brew install boost

  # Install NetCDF
  echo "Installing NetCDF..."
  brew install netcdf

  # Install Eigen
  echo "Installing Eigen..."
  brew install eigen

  # Download and install Gurobi
  echo "Downloading and installing Gurobi..."
  cd /Library
  curl -O https://packages.gurobi.com/10.0/gurobi10.0.3_macos_universal2.pkg
  sudo installer -pkg gurobi10.0.3_macos_universal2.pkg -target /
  rm gurobi10.0.3_macos_universal2.pkg
  export GUROBI_HOME="/Library/gurobi1003"
  export PATH="${PATH}:${GUROBI_HOME}/bin"
  echo "GUROBI_HOME: $GUROBI_HOME"
  echo "PATH: $PATH"

  # Install SCIP
  echo "Installing SCIP..."
  brew install gcc tbb
  curl -O https://www.scipopt.org/download/release/SCIPOptSuite-9.0.0-Darwin.sh
  chmod u+x SCIPOptSuite-9.0.0-Darwin.sh
  ./SCIPOptSuite-9.0.0-Darwin.sh --prefix=/Library/scip --exclude-subdir --skip-license
  rm SCIPOptSuite-9.0.0-Darwin.sh

  # Install HiGHS
  echo "Installing HiGHS..."
  git clone https://github.com/ERGO-Code/HiGHS.git /Library/HiGHS
  cd /Library/HiGHS
  mkdir build
  cd build
  cmake -DFAST_BUILD=ON -DCMAKE_INSTALL_PREFIX=/Library/HiGHS ..
  cmake --build .
  sudo cmake --install .
  cd ../..

  # Install COIN-OR CoinUtils and Osi/Clp
  echo "Installing COIN-OR CoinUtils and Osi/Clp..."
  brew install coinutils bz2 lapack openblas
  cd /Library
  curl -O https://raw.githubusercontent.com/coin-or/coinbrew/master/coinbrew
  chmod u+x coinbrew
  ./coinbrew fetch CoinUtils --no-prompt
  ./coinbrew build CoinUtils --prefix=/Library/coin-or --no-prompt --tests=none
  ./coinbrew build Osi --prefix=/Library/coin-or --no-prompt --tests=none --without-cplex --with-gurobi --with-gurobi-lib="-L$GUROBI_HOME/lib -lgurobi100" --with-gurobi-incdir="$GUROBI_HOME/include"
  ./coinbrew build Clp --prefix=/Library/coin-or --no-prompt --tests=none
  rm coinbrew

  # Install StOpt
  echo "Installing StOpt..."
  brew install zlib
  git clone https://gitlab.com/stochastic-control/StOpt /Library/StOpt
  cd /Library/StOpt
  mkdir build
  cd build
  cmake -DBUILD_PYTHON=OFF -DBUILD_TEST=OFF ..
  cmake --build .
  sudo cmake --install . --prefix=/Library/stopt
  cd ../..

  echo "Installation completed successfully on macOS."

  # Return to the original directory
  cd "$current_dir"
}

# Function to install software on Windows
function install_on_windows() {
  # Save current directory
  local current_dir
  current_dir=$(pwd)

  echo "Starting the installation process on Windows..."

  # Ensure the directory for vcpkg exists and move to it
  echo "Preparing the installation directory for vcpkg..."
  mkdir -p /c/vcpkg
  cd /c/vcpkg

  # Install vcpkg
  echo "Installing vcpkg..."
  git clone https://github.com/microsoft/vcpkg.git .
  ./bootstrap-vcpkg.bat

  # Install basic requirements
  echo "Installing basic requirements with vcpkg..."
  ./vcpkg install cmake git --triplet x64-windows
  ./vcpkg install zlib bzip2 pthreads getopt --triplet x64-windows

  # Install Boost libraries
  echo "Installing Boost libraries..."
  ./vcpkg install boost boost-mpi --triplet x64-windows

  # Install Eigen
  echo "Installing Eigen..."
  ./vcpkg install eigen3 --triplet x64-windows

  # Install NetCDF
  echo "Installing NetCDF..."
  ./vcpkg install netcdf-cxx4 --triplet x64-windows

  # Move to C:\ for other dependencies
  echo "Moving to C:\ for downloading and installing other dependencies..."
  cd /c/

  # Download and install Gurobi
  echo "Downloading and installing Gurobi..."
  local gurobi_installer="Gurobi-10.0.3-win64.msi"
  curl -LO "https://packages.gurobi.com/10.0/$gurobi_installer"
  cmd //c start /wait msiexec /i $gurobi_installer /qn
  rm $gurobi_installer

  # Download and install SCIP
  echo "Downloading and installing SCIP..."
  local scip_installer="SCIPOptSuite-9.0.0-win64-VS15.exe"
  curl -LO "https://www.scipopt.org/download.php?fname=$scip_installer"
  cmd //c start /wait $scip_installer /SILENT
  rm $scip_installer

  # Install HiGHS
  echo "Installing HiGHS..."
  git clone https://github.com/ERGO-Code/HiGHS.git
  cd HiGHS
  mkdir build
  cd build
  cmake -DFAST_BUILD=ON -DCMAKE_INSTALL_PREFIX=C:/HiGHS ..
  cmake --build .
  cmake --install .
  cd ../..

  # Move to C:\vcpkg to install COIN-OR CoinUtils and Osi/Clp
  printf "Moving to C:\\vcpkg for installing COIN-OR CoinUtils and Osi/Clp...\n"
  cd /c/vcpkg

  # Install COIN-OR CoinUtils
  echo "Installing COIN-OR CoinUtils..."
  ./vcpkg install coinutils pybind11 blas lapack --triplet x64-windows

  echo "Modifying COIN-OR Osi portfile.cmake for Gurobi support..."
  cd /c/vcpkg/ports/coin-or-osi

  # Backup the original portfile.cmake just in case
  cp portfile.cmake portfile.cmake.bak

  # Use sed `s/old/new/` to replace the configuration line
  sed -i 's/--with-gurobi/&\
          --with-gurobi-lib=C:\\\/gurobi1003\\\/win64\\\/lib\\\/gurobi100.lib\
          --with-gurobi-incdir=C:\\\/gurobi1003\\\/win64\\\/include\
          --with-gurobi-cflags=-IC:\\\/gurobi1003\\\/win64\\\/include\
          --with-gurobi-lflags=C:\\\/gurobi1003\\\/win64\\\/lib\\\/gurobi100.lib/' portfile.cmake

  echo "COIN-OR Osi portfile modified for Gurobi support."

  # Install COIN-OR Osi/Clp
  echo "Installing COIN-OR Osi with Gurobi support..."
  cd /c/vcpkg
  ./vcpkg install blas lapack --triplet x64-windows
  ./vcpkg install coin-or-osi coin-or-clp glpk pybind11 --triplet x64-windows

  # Setup vcpkg for StOpt installation
  echo "Setting up vcpkg for StOpt installation..."
  cd /c/
  git clone https://gitlab.com/stochastic-control/vcpkg-registry
  cd /c/vcpkg

  # Install StOpt using custom vcpkg registry
  echo "Installing StOpt..."
  ./vcpkg install stopt --overlay-ports=/c/vcpkg/vcpkg-registry/ports/stopt --triplet x64-windows
  rm -rf /c/vcpkg-registry

  echo "Installation completed successfully on Windows."

  # Return to the original directory
  cd "$current_dir"
}

# Detect operating system and execute the appropriate installation function
OS="$(uname)"
case "$OS" in
"Linux")
  if [ -f /etc/lsb-release ]; then
    . /etc/lsb-release
    if [ "$DISTRIB_ID" = "Ubuntu" ]; then
      install_on_ubuntu
    else
      echo "This script supports Ubuntu only."
    fi
  else
    echo "This script supports Ubuntu only."
  fi
  ;;
"Darwin")
  install_on_macos
  ;;
"Windows")
  install_on_windows
  ;;
*)
  echo "This script does not support the detected operating system."
  ;;
esac

# Compile SMSpp
echo "Compiling SMSpp..."
mkdir -p build
cd build
cmake ..
cmake --build . --config Release
if [[ "$OS" != "Windows" ]]; then
  sudo cmake --install .
else
  cmake --install .
fi
cd ..
