##############################################################################
############################ makefile-libBoost ###############################
##############################################################################
#                                                                            #
#   makefile of libBoost                                                     #
#                                                                            #
#   Input:  $(SMS++SDR) = the directory where the core SMS++ source is       #
#           According to the standard library layout, it is assumed that     #
#           the external libreries live in $(SMS++SDR)../extlib              #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libBoostINC) = the -I$(include directories) for Boost          #
#           $(libBoostLIB) = external libreries + -L<libdirs> for Boost      #
#                                                                            #
#                                VERSION 2.10                                #
#                               28 - 10 - 2020                               #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Operations Research Group                          #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# define the macroes to be exported - - - - - - - - - - - - - - - - - - - - -

libBoostINC = -I/usr/local/include/ -DBOOST_LOG_DYN_LINK
libBoostLIB = -L/usr/local/lib -lboost_log-mt

############################# End of makefile ################################
