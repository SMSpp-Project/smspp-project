# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# external libreries that Gurobi needs
ifeq ($(UNAME_S),Linux)
    libCPLEXEXTLIB = -lpthread
else # macOS
    libCPLEXEXTLIB =
endif

# basic Gurobi directory
libGUROBIBSCDIR = $(GUROBI_HOME)/

# lib Gurobi directory
libGUROBIINCDIR = $(libGUROBIBSCDIR)lib/

# macroes to be exported- - - - - - - - - - - - - - - - - - - - - - - - - - -

libGUROBILIB = -L$(libGUROBIINCDIR) -lgurobi100
libGUROBIINC = -I$(libGUROBIBSCDIR)include/

############################# End of makefile ################################