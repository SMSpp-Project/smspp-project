##############################################################################
############################# makefile-libGUROBI #############################
##############################################################################
#                                                                            #
#   makefile of libGUROBI                                                    #
#                                                                            #
#   Input:  $(GUROBI_ROOT), the directory where Gurobi is installed          #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#                                                                            #
#           $(libGUROBILIB) = external libraries + -L< libdirs > for         #
#                             libGUROBI                                      #
#           $(libGUROBIINC) = the -I$(include directories) for libGUROBI     #
#           $(GUROBI_PRESENT) = non-empty if and only if gurobi_c.h is       #
#                               there                                        #
#                                                                            #
#                              Antonio Frangioni                             #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# external libraries that Gurobi needs
ifeq ($(UNAME_S),Linux)
    libGUROBIEXTLIB = -lpthread
endif
ifeq ($(UNAME_S),Darwin)
    libGUROBIEXTLIB =
endif

# basic Gurobi directory
ifeq ($(UNAME_S),Linux)
    libGUROBIBSCDIR = $(GUROBI_ROOT)/linux64
endif
ifeq ($(UNAME_S),Darwin)
    libGUROBIBSCDIR = $(GUROBI_ROOT)/macos_universal2
endif

# Gurobi is there if its header is; then its library has to be there too
GUROBI_PRESENT := $(wildcard $(libGUROBIBSCDIR)/include/gurobi_c.h)

# extract Gurobi version
ifeq ($(UNAME_S),Linux)
    libGUROBISFX = so
endif
ifeq ($(UNAME_S),Darwin)
    libGUROBISFX = dylib
endif
ifneq ($(GUROBI_PRESENT),)
    GUROBI_VERSION := $(shell \
        ls "$(libGUROBIBSCDIR)/lib" 2>/dev/null \
        | grep -E '^libgurobi[0-9]+\.$(libGUROBISFX)$$' \
        | sed -E 's/^libgurobi([0-9]+)\.$(libGUROBISFX)$$/\1/' \
        | head -n1 \
    )
    ifeq ($(GUROBI_VERSION),)
        $(error no libgurobi<version>.$(libGUROBISFX) in \
                $(libGUROBIBSCDIR)/lib, where gurobi_c.h is)
    endif
endif

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libGUROBILIB = -L"$(libGUROBIBSCDIR)/lib" -lgurobi$(GUROBI_VERSION) \
	$(libGUROBIEXTLIB)
libGUROBIINC = -I"$(libGUROBIBSCDIR)/include"

####################### End of makefile-libGUROBI ############################
