##############################################################################
########################## makefile-libAStarSearch ###########################
##############################################################################
#                                                                            #
#   makefile of libAStarSearch                                               #
#                                                                            #
#   Input:  $(AStarSearch_ROOT), the directory where AStarSearch is          #
#           installed, i.e., the headers are in                              #
#           $(AStarSearch_ROOT)/include/AStarSearch and the library is in    #
#           $(AStarSearch_ROOT)/lib (e.g., by make install                   #
#           PREFIX=$(AStarSearch_ROOT) in the sources of AStarSearch)        #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libAStarSearchLIB) = external libraries + -L< libdirs >        #
#           $(libAStarSearchINC) = the -I$(include directories)              #
#                                                                            #
#                                Donato Meoli                                #
#                         Dipartimento di Informatica                        #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic AStarSearch directory without quotes, if any
libAStarSearchBSCDIR = $(subst $\",,$(AStarSearch_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libAStarSearchINC = -I"$(libAStarSearchBSCDIR)/include"

ifeq ($(UNAME_S),Linux)
    libAStarSearchLIB = -L"$(libAStarSearchBSCDIR)/lib" \
	-Wl,-rpath,"$(libAStarSearchBSCDIR)/lib" -lAStarSearch -pthread
endif
ifeq ($(UNAME_S),Darwin)
    libAStarSearchLIB = -rpath "$(libAStarSearchBSCDIR)/lib" \
	-L"$(libAStarSearchBSCDIR)/lib" -lAStarSearch -pthread
endif

###################### End of makefile-libAStarSearch ########################
