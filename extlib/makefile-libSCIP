##############################################################################
############################## makefile-libSCIP ##############################
##############################################################################
#                                                                            #
#   makefile of libSCIP                                                      #
#                                                                            #
#   Input:  SCIP_ROOT, the directory where SCIP is installed                 #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#                                                                            #
#           $(libSCIPLIB) = external libraries + -L< libdirs > for libSCIP   #
#           $(libSCIPINC) = the -I$(include directories) for libSCIP         #
#           $(SCIP_PRESENT) = non-empty if and only if scip.h is there       #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Dipartimento di Informatica                       #
#                              Universita' di Pisa                           #
#                                                                            #
##############################################################################

include $(dir $(lastword $(MAKEFILE_LIST)))makefile-sysinc

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic SCIP directory without quotes, if any
libSCIPBSCDIR = $(subst $\",,$(SCIP_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libSCIPLIB = -L"$(libSCIPBSCDIR)/lib" -Wl,-rpath,"$(libSCIPBSCDIR)/lib" \
	-lscip -ltbb
libSCIPINC = $(call SMSppSYSINC,$(libSCIPBSCDIR)/include)

SCIP_PRESENT := $(wildcard $(libSCIPBSCDIR)/include/scip/scip.h)

######################### End of makefile-libSCIP ############################
