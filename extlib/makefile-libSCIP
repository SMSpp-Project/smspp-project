#   Input:  none, this is a pre-built library                                #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libSCIPLIB) = external libreries + -L<libdirs> for libSCIP     #
#           $(libSCIPINC) = the -I$(include directories) for libSCIP         #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Dipartimento di Informatica                       #
#                              Universita' di Pisa                           #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic SCIP directory
ifeq ($(UNAME_S),Linux)
    libSCIPBSCDIR = /usr/local/
else # macOS
    libSCIPBSCDIR = /Users/frangio/Applications/SCIP-8.0.0/
endif

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libSCIPLIB = -L$(libSCIPBSCDIR)lib/ -lzimpl -lsoplex -lscip -ltbb
libSCIPINC = -I$(libSCIPBSCDIR)include/

############################# End of makefile ################################
