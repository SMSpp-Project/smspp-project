##############################################################################
############################# makefile-libStOpt ##############################
##############################################################################
#                                                                            #
#   makefile of libStOpt                                                     #
#                                                                            #
#   Input:  none, this is a pre-built library                                #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libStOptLIB) = external libreries + -L<libdirs> for libStOpt   #
#           $(libStOptINC) = the -I$(include directories) for libStOpt       #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Dipartimento di Informatica                       #
#                              Universita' di Pisa                           #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic StOpt directory
ifeq ($(UNAME_S),Linux)
    libStOptBSCDIR = /usr/local/
endif
ifeq ($(UNAME_S),Darwin)
    libStOptBSCDIR = /Users/frangio/Applications/StOpt/install/
endif

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

ifeq ($(UNAME_S),Linux)
    libStOptLIB = -L$(libStOptBSCDIR)lib/ -lStOpt -lgeners \
	    -L$(libStOptBSCDIR)lib/x86_64-linux-gnu/ -lboost_timer
endif
ifeq ($(UNAME_S),Darwin)
    libStOptLIB = -L$(libStOptBSCDIR)lib/ -lStOpt -lgeners -lboost_timer-mt
endif
libStOptINC = -I$(libStOptBSCDIR)include/

############################# End of makefile ################################
