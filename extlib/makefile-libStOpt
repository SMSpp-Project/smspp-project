##############################################################################
############################# makefile-libStOpt ##############################
##############################################################################
#                                                                            #
#   makefile of libStOpt                                                     #
#                                                                            #
#   Input:  $(StOpt_ROOT), the directory where StOpt is installed            #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#                                                                            #
#           $(libStOptLIB) = external libraries + -L< libdirs > for libStOpt #
#           $(libStOptINC) = the -I$(include directories) for libStOpt       #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Dipartimento di Informatica                       #
#                              Universita' di Pisa                           #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic StOpt directory without quotes, if any
libStOptBSCDIR = $(subst $\",,$(StOpt_ROOT))

# --showme is OpenMPI syntax; with other MPI implementations (e.g. MPICH)
# StOpt_MPI_INC must be set manually
StOpt_MPI_CXX ?= mpicxx
StOpt_MPI_INC ?= $(shell $(StOpt_MPI_CXX) --showme:compile 2>/dev/null)

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# the libraries are in lib/, or in a directory of it (e.g., the one of the
# architecture on Debian)
libStOptLIB = -L"$(libStOptBSCDIR)/lib" $(patsubst %,-L"%", \
	    $(sort $(dir $(wildcard $(addprefix $(libStOptBSCDIR)/lib/*/, \
	    libStOpt.* libgeners.* libboost_timer.*))))) \
	    -lStOpt -lgeners -lboost_timer
# StOpt is built with MPI, hence whoever includes its headers (and the
# boost::mpi ones) needs the MPI headers too
libStOptINC = -I"$(libStOptBSCDIR)/include" \
	    -I"$(libStOptBSCDIR)/include/geners" \
	    $(StOpt_MPI_INC)

######################## End of makefile-libStOpt ############################
