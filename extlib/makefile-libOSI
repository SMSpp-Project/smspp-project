# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic COIN directory
libOSIBSCDIR = /usr/local/

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libOSILIB = -L$(libOSIBSCDIR)lib -lOsiClp -lClp -lOsi -lCoinUtils
libOSIINC = -I$(libOSIBSCDIR)include/coin

############################# End of makefile ################################
