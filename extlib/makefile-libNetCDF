##############################################################################
############################# makefile-libNetCDF #############################
##############################################################################
#                                                                            #
#   makefile of libNetCDF                                                    #
#                                                                            #
#   Input:  $(netCDF_ROOT) and $(netCDFxx_ROOT), the directories where       #
#           netCDF (basic C lib) and its C++ interface are installed         #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#                                                                            #
#           $(libNtCDFINC) = the -I$(include directories) for NetCDF	     #
#           $(libNtCDFLIB) = external libraries + -L< libdirs > for NetCDF   #
#                                                                            #
#                             Antonio Frangioni                              #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic netCDF directories without quotes, if any
libnetCDFBSCDIR = $(subst $\",,$(netCDF_ROOT))
libnetCDFCxxBSCDIR = $(subst $\",,$(netCDFCxx_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

ifeq ($(UNAME_S),Linux)
    libNtCDFLIB = -L"$(libnetCDFBSCDIR)/lib/x86_64-linux-gnu" -lnetcdf \
              -L"$(libnetCDFCxxBSCDIR)/lib/x86_64-linux-gnu" -lnetcdf_c++4
else
    libNtCDFLIB = -L"$(libnetCDFBSCDIR)/lib" -lnetcdf \
              -L"$(libnetCDFCxxBSCDIR)/lib" -lnetcdf-cxx4
endif
libNtCDFINC = -I"$(libnetCDFBSCDIR)/include" -I"$(libnetCDFCxxBSCDIR)/include"

############################# End of makefile ################################
