# define the macroes to be exported - - - - - - - - - - - - - - - - - - - - -

libNtCDFINC = -I/usr/local/Cellar/netcdf/4.6.1_2/include/
libNtCDFLIB = -L/usr/local/Cellar/netcdf/4.6.1_2/lib/ -lnetcdf -lnetcdf-cxx4

