##############################################################################
############################# makefile-libNetCDF #############################
##############################################################################
#                                                                            #
#   makefile of libNetCDF                                                    #
#                                                                            #
#   Input:  $(netCDF_ROOT) and $(netCDFxx_ROOT), the directories where       #
#           netCDF (basic C lib) and its C++ interface are installed         #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#                                                                            #
#           $(libNtCDFINC) = the -I$(include directories) for NetCDF         #
#           $(libNtCDFLIB) = external libraries + -L< libdirs > for NetCDF   #
#                                                                            #
#                             Antonio Frangioni                              #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic netCDF directories without quotes, if any
libNtCDFBSCDIR = $(subst $\",,$(netCDF_ROOT))
libNtCDFCxxBSCDIR = $(subst $\",,$(netCDFCxx_ROOT))

# the libraries, in lib/ or in a directory of it (e.g., the one of the
# architecture on Debian), the C++ one with either of its two names
libNtCDFFILE = $(firstword $(wildcard $(libNtCDFBSCDIR)/lib/libnetcdf.* \
        $(libNtCDFBSCDIR)/lib/*/libnetcdf.*))
libNtCDFCxxFILE = $(firstword $(wildcard $(addprefix \
        $(libNtCDFCxxBSCDIR)/lib/,libnetcdf_c++4.* libnetcdf-cxx4.* \
        */libnetcdf_c++4.* */libnetcdf-cxx4.*)))
libNtCDFCxxNAME = $(if $(findstring netcdf-cxx4,$(libNtCDFCxxFILE)), \
        netcdf-cxx4,netcdf_c++4)

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libNtCDFLIB = -L"$(or $(dir $(libNtCDFFILE)),$(libNtCDFBSCDIR)/lib/)" \
        -lnetcdf \
        -L"$(or $(dir $(libNtCDFCxxFILE)),$(libNtCDFCxxBSCDIR)/lib/)" \
        -l$(strip $(libNtCDFCxxNAME))
libNtCDFINC = -I"$(libNtCDFBSCDIR)/include" -I"$(libNtCDFCxxBSCDIR)/include"

####################### End of makefile-libNetCDF ############################
