##############################################################################
############################# makefile-libNetCDF #############################
##############################################################################
#                                                                            #
#   makefile of libNetCDF                                                    #
#                                                                            #
#   Input:  $(SMS++SDR) = the directory where the core SMS++ source is       #
#           According to the standard library layout, it is assumed that     #
#           the external libreries live in $(SMS++SDR)../extlib              #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libNtCDFINC) = the -I$(include directories) for NetCDF	     #
#           $(libNtCDFLIB) = external libreries + -L<libdirs> for NetCDF     #
#                                                                            #
#                             Antonio Frangioni                              #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# define the macros to be exported- - - - - - - - - - - - - - - - - - - - - -

ifeq ($(UNAME_S),Linux)
    libNtCDFLIB = -L$(netCDFCxx_ROOT)/x86_64-linux-gnu/ -lnetcdf -lnetcdf_c++4
endif
ifeq ($(UNAME_S),Darwin)
    libNtCDFLIB = -L$(netCDFCxx_ROOT)/lib/ -lnetcdf -lnetcdf-cxx4
endif
libNtCDFINC = -I$(netCDF_ROOT)/include/

############################# End of makefile ################################
