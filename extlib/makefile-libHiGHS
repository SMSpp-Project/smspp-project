##############################################################################
#                                                                            #
#   makefile of libHiGHS                                                     #
#                                                                            #
#   Input:  $(HiGHS_ROOT), the directory where HiGHS is installed            #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libHiGHSLIB) = external libreries + -L<libdirs> for libHiGHS   #
#           $(libHiGHSINC) = the -I$(include directories) for libHiGHS       #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Dipartimento di Informatica                        #
#                            Universita' di Pisa                             #
#                                                                            #
#                             Enrico Calandrini                              #
#                         Dipartimento di Informatica                        #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

ifeq ($(UNAME_S),Linux)
    libHiGHSLIB = -L$(HiGHS_ROOT)/lib -lhighs -lpthread
endif
ifeq ($(UNAME_S),Darwin)
    libHiGHSLIB = -L$(HiGHS_ROOT)/lib -lhighs
endif

libHiGHSLIB = -L$(HiGHS_ROOT)/lib -lhighs
libHiGHSINC = -I$(HiGHS_ROOT)/interfaces -I$(HiGHS_ROOT)/include/highs \
	-I$(HiGHS_ROOT)/include/highs/docs/c_api_gen

######################## End of makefile-libHiGHS ############################
