# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic HiGHS directory
libHiGHSBSCDIR = /usr/local/

# external libreries that Gurobi needs
# Linux
#libHiGHSEXTLIB = -lpthread
# Mac OSX
libHiGHSEXTLIB =

# lib Gurobi directory
libHiGHSINCDIR = $(libHiGHSBSCDIR)/include/highs/

# macroes to be exported- - - - - - - - - - - - - - - - - - - - - - - - - - -

libHiGHSLIB = -L$(libHiGHSBSCDIR)/lib/ -lhighs
libHiGHSINC = -I$(libHiGHSINCDIR)interfaces/ -I$(libHiGHSINCDIR) -I$(libHiGHSINCDIR)docs/c_api_gen/

############################# End of makefile ################################