##############################################################################
############################## makefile-libOSQP ##############################
##############################################################################
#                                                                            #
#   makefile of libOSQP                                                      #
#                                                                            #
#   Input:  $(osqp_ROOT), the directory where OSQP is installed, i.e., the   #
#           headers are in $(osqp_ROOT)/include/osqp and the library is in   #
#           $(osqp_ROOT)/lib                                                 #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libOSQPLIB) = external libraries + -L< libdirs > for libOSQP   #
#           $(libOSQPINC) = the -I$(include directories) for libOSQP         #
#                                                                            #
#   OSQP exports its internal functions, some of which have the name of      #
#   functions of other libraries (e.g., csc_copy, also in HiGHS), and on     #
#   Linux the first library loaded gives the function to both. Hence the     #
#   static library libosqpstatic is used if it is there and the linker can   #
#   keep its symbols local to the executable, and the shared one otherwise.  #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

include $(dir $(lastword $(MAKEFILE_LIST)))makefile-sysinc

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic OSQP directory without quotes, if any
libOSQPBSCDIR = $(subst $\",,$(osqp_ROOT))

# non-empty if and only if the static library of OSQP is there
libOSQPSTATIC = $(wildcard $(libOSQPBSCDIR)/lib/libosqpstatic.a)

# non-empty if and only if the linker can keep the symbols of a static
# library local, asked the first time that it is needed, when $(CC) has its
# final value, and then remembered
libOSQPLOCAL = $(eval libOSQPLOCAL := $$(shell echo 'int main(){}' \
	| $$(CC) -x c++ - -Wl,--exclude-libs,libosqpstatic.a -o /dev/null \
	>/dev/null 2>&1 && echo yes))$(libOSQPLOCAL)

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libOSQPINC = $(call SMSppSYSINC,$(libOSQPBSCDIR)/include/osqp)

libOSQPLIBSTATIC = "$(libOSQPBSCDIR)/lib/libosqpstatic.a" \
	-Wl,--exclude-libs,libosqpstatic.a
libOSQPLIBSHARED = -L"$(libOSQPBSCDIR)/lib" \
	-Wl,-rpath,"$(libOSQPBSCDIR)/lib" -losqp

libOSQPLIB = $(if $(and $(libOSQPSTATIC),$(libOSQPLOCAL)), \
	$(libOSQPLIBSTATIC),$(libOSQPLIBSHARED))

######################## End of makefile-libOSQP #############################
