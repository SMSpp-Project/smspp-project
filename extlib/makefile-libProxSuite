##############################################################################
########################### makefile-libProxSuite ############################
##############################################################################
#                                                                            #
#   makefile of libProxSuite                                                 #
#                                                                            #
#   Input:  $(proxsuite_ROOT), the directory where ProxSuite is installed,   #
#           i.e., the headers are in $(proxsuite_ROOT)/include/proxsuite     #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libProxSuiteINC) = the -I$(include directories) for            #
#                                libProxSuite                                #
#                                                                            #
#   ProxSuite is header-only, hence there is no $(libProxSuiteLIB); it       #
#   needs Eigen, whose -I is in $(SMS++INC).                                 #
#                                                                            #
#                                Donato Meoli                                #
#                         Dipartimento di Informatica                        #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# basic ProxSuite directory without quotes, if any
libProxSuiteBSCDIR = $(subst $\",,$(proxsuite_ROOT))

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

libProxSuiteINC = -I"$(libProxSuiteBSCDIR)/include"

##################### End of makefile-libProxSuite ###########################
