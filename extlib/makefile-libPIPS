##############################################################################
############################## makefile-libPIPS ##############################
##############################################################################
#                                                                            #
#   makefile of libPIPS                                                      #
#                                                                            #
#   Input:  $(PIPSIPMPP_ROOT), the directory where PIPS-IPM++ is installed   #
#           or checked out                                                   #
#                                                                            #
#   Output: accordingly, there is no *H and *OBJ in output, since there is   #
#           no need to check for changes in the .h and rebuild the .o / .a   #
#           $(libPIPSLIB) = external libraries + -L<libdirs> for libPIPS     #
#           $(libPIPSINC) = the -I$(include directories) for libPIPS         #
#                                                                            #
#                             Enrico Calandrini                              #
#                        Dipartimento di Informatica                         #
#                            Universita' di Pisa                             #
#                                                                            #
##############################################################################

# internal macros - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

PIPSIPMPP_ROOT ?= $(HOME)/pips-ipmpp
PIPS_BUILD_DIR ?= $(PIPSIPMPP_ROOT)/build
PIPSROOT ?= $(PIPSIPMPP_ROOT)/PIPS-IPM

PIPS_CORE_LIB_DIR ?= $(PIPS_BUILD_DIR)/PIPS-IPM/Core
PIPS_LINEAR_SOLVERS_LIB_DIR ?= $(PIPS_CORE_LIB_DIR)/LinearSolvers

PIPS_PARDISO_SRC_DIR ?= $(PIPSIPMPP_ROOT)/ThirdPartyLibs/PARDISO/src
PIPS_PARDISO_LIB_DIR ?= \
	$(if $(PARDISO_DIR),$(PARDISO_DIR),$(PIPS_PARDISO_SRC_DIR))
PIPS_WITH_PARDISO ?= \
	$(if $(wildcard $(PIPS_PARDISO_LIB_DIR)/libpardiso.so),1,0)
PIPS_WITH_MA57 ?= \
	$(if $(wildcard $(PIPS_LINEAR_SOLVERS_LIB_DIR)/libma57.a),1,0)
PIPS_WITH_MUMPS ?= 1

# --showme is OpenMPI syntax; with other MPI implementations (e.g. MPICH)
# PIPS_MPI_INC / PIPS_MPI_LIBS must be set manually
PIPS_MPI_CXX ?= mpicxx
PIPS_MPI_INC ?= $(shell $(PIPS_MPI_CXX) --showme:compile 2>/dev/null)
PIPS_MPI_LIBS ?= $(shell $(PIPS_MPI_CXX) --showme:link 2>/dev/null) \
	-Wl,--no-as-needed -lmpi_mpifh -lmpi -Wl,--as-needed

PIPS_OPENMP_LIBS ?= -fopenmp
PIPS_MATH_LIBS ?= -llapack -lblas
PIPS_MUMPS_LIBS ?= -ldmumps -lmumps_common -lpord
PIPS_METIS_LIBS ?= -lmetis

# the GNU Fortran runtime is required by the Fortran parts of PIPS-IPM++ and
# of its linear solvers; plain -lgfortran only resolves if the development
# symlink is installed, hence fall back to the versioned runtime, and only
# then to -lgfortran, when it is not
PIPS_FORTRAN_LIBS ?= $(firstword \
	$(wildcard $(shell $(CC) -print-file-name=libgfortran.so 2>/dev/null)) \
	$(wildcard $(shell $(CC) -print-file-name=libgfortran.so.5 2>/dev/null)) \
	-lgfortran)

ifeq ($(PIPS_WITH_MUMPS),1)
    PIPS_MUMPS_SOLVER_LIBS ?= -lmumps_solver
else
    PIPS_MUMPS_SOLVER_LIBS ?=
    PIPS_MUMPS_LIBS :=
endif

ifeq ($(PIPS_WITH_PARDISO),1)
    PIPS_PARDISO_SOLVER_LIBS ?= -lpardiso_solver -lpardiso_abstract
    PIPS_PARDISO_LIBS ?= -L"$(PIPS_PARDISO_LIB_DIR)" -lpardiso
else
    PIPS_PARDISO_SOLVER_LIBS ?=
    PIPS_PARDISO_LIBS ?=
endif

ifeq ($(PIPS_WITH_MA57),1)
    PIPS_MA57_SOLVER_LIBS ?= -lma57 -lmetis_adapter
    PIPS_MA57_LIBS ?= $(PIPS_METIS_LIBS)
else
    PIPS_MA57_SOLVER_LIBS ?=
    PIPS_MA57_LIBS ?=
endif

PIPS_SOLVER_LIBS ?= \
	$(PIPS_MUMPS_SOLVER_LIBS) \
	$(PIPS_PARDISO_SOLVER_LIBS) \
	$(PIPS_MA57_SOLVER_LIBS)

PIPS_EXTERNAL_LIBS ?= \
	$(PIPS_MUMPS_LIBS) \
	$(PIPS_PARDISO_LIBS) \
	$(PIPS_MA57_LIBS) \
	$(PIPS_MPI_LIBS) \
	$(PIPS_OPENMP_LIBS) \
	$(PIPS_MATH_LIBS) \
	$(PIPS_FORTRAN_LIBS)

# the PIPS-IPM++ headers include the MPI ones, hence whoever compiles against
# them needs the MPI include path too
libPIPSINC = \
	$(PIPS_MPI_INC) \
	-I"$(PIPSROOT)/Core/Interface" \
	-I"$(PIPSROOT)/Core/Options" \
	-I"$(PIPSROOT)/Core/Utilities" \
	-I"$(PIPSROOT)/Core/InteriorPointMethod" \
	-I"$(PIPSROOT)/Core/LinearAlgebra" \
	-I"$(PIPSROOT)/Core" \
	-I"$(PIPSROOT)/Drivers/CallbackExample" \
	-I"$(PIPSROOT)/Core/Readers/Distributed"

# the PIPS-IPM++ libraries are shared and live outside the standard search
# path, hence the rpath, so that a binary built with the makefiles finds them
# at run time exactly as one built with CMake does
libPIPSLIB = \
	-Wl,-rpath,"$(PIPS_CORE_LIB_DIR)" \
	-Wl,-rpath,"$(PIPS_LINEAR_SOLVERS_LIB_DIR)" \
	-L"$(PIPS_CORE_LIB_DIR)" \
	-lpips-ipmpp \
	-L"$(PIPS_LINEAR_SOLVERS_LIB_DIR)" \
	$(PIPS_SOLVER_LIBS) \
	$(PIPS_EXTERNAL_LIBS)

######################### End of makefile-libPIPS ############################
