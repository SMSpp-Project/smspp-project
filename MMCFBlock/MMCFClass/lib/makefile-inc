##############################################################################
############################### makefile-inc #################################
##############################################################################
#                                                                            #
#   makefile of libMMCF as a pre-built library                                #
#                                                                            #
#   Input:  $(libMMCFSDR) = the directory where the core libMMCF source is     #
#                                                                            #
#   Output: accordingly, there is no in output, since there is no need to    #
#           check for changes in the .h and rebuild the .o / .a. Also, the   #
#           *OBJ is just the library                                         #
#           $(libMMCFINC) = the -I$(include directories) for libMMCF           #
#           $(libMMCFLIB) = external libreries + -L<libdirs> for libMMCF       #
#           $(libMMCFOBJ) = the liblibMMCF library itself                      #
#                                                                            #
#   Indeed, the makefile only calls makefile-c and strips away the *H and    #  
#   *OBJ macros. This is not even necessary, it is only made for clarity.    #
#                                                                            #
#                                VERSION 1.00                                #
#                               26 - 01 - 2019                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Operations Research Group                         #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#									     #
##############################################################################

# include the libMMCF makefile internally defining all external modules - - - -

include $(libMMCFSDR)lib/makefile-c

# re-define the OBJ as the library- - - - - - - - - - - - - - - - - - - - - -

libMMCFOBJ = $(libMMCFSDR)lib/libMMCF.a

# ensure that the library is properly constructed - - - - - - - - - - - - - -
# force the make to be always executed

$(libMMCFOBJ): FORCE
	make -f $(libMMCFSDR)lib/makefile-lib libMMCFSDR=$(libMMCFSDR)
FORCE:

# clean-up unrequired things- - - - - - - - - - - - - - - - - - - - - - - - -

libMMCFH =

# clean - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

clean::
	make -f $(libMMCFSDR)lib/makefile-lib clean libMMCFSDR=$(libMMCFSDR) 

########################## End of makefile-inc ###############################
