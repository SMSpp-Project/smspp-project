##############################################################################
############################## makefile-lib ##################################
##############################################################################
#                                                                            #
#   makefile of libMMCF - frontend for building the library                  #
#                                                                            #
#   Input:  $(libMMCFSDR) = the (base) directory where the libMMCF source is #
#           If the variable is not defined, "../" is used since it is        #
#           assumed that the makefile is ran in the lib/ sub-folder.         #
#                                                                            #
#   Output: none, just the library being built                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Dipartimento di Informatica                       #
#                              Universita' di Pisa                           #
#                                                                            #
##############################################################################

ifndef libMMCFSDR
libMMCFSDR = ../
endif

# module name
NAME = $(libMMCFSDR)lib/libMMCF.a

# debug switches
SW = -g -std=c++14
# production switches
#SW = -O3 -DNDEBUG -std=c++11

# compiler
CC = clang++

# default target- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

default: $(NAME)

# build = default - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

build: $(NAME)

# clean - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

clean::
	rm -f $(NAME)

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object(s) / library
# *LIB is the external libreries + -L<libdirs>
# *H   is the list of all include files
# *INC is the -I<include directories>

# libMMCF (complete with external libraries)
include $(libMMCFSDR)lib/makefile-c

# archive the library - - - - - - - - - - - - - - - - - - - - - - - - - - - -

$(NAME): $(libMMCFOBJ)
	ar -ruv $(NAME) $(libMMCFOBJ)

########################## End of makefile-lib ###############################
