# --- Project-specific ---------------------------------------
# Local override of external-library paths (gitignored on purpose)
extlib/makefile-paths

# Install tree produced by `make install` / CMake install
bin/
lib/
share/
include/

# Doxygen output
doc/html/
doc/latex/

# Claude Code local notes (kept out of the repo)
CLAUDE.md

# --- C/C++ build artifacts ----------------------------------
*.o
*.obj
*.d
*.gch
*.pch
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/
*.pdb
*.idb
*.ilk
*.map
*.exp
*.gcno
*.gcda

# --- CMake --------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeLists.txt.user
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# --- IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
out/

