##############################################################################
################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of BundleSolver                                        #
#                                                                            #
#   The makefile defines internally all external libraries (comprised the    #
#   SMS++ one) required by BundleSolver. Accordingly, all necessary OBJ, H,  #
#   -I directives, external libraries + -L<libdirs> are added to the         #
#   corresponding BNDSLV* macros.                                            #
#                                                                            #
#   Input:  $(CC)       = compiler command                                   #
#           $(SW)       = compiler options                                   #
#           $(LDSSLVSDR) = the directory where BundleSolver source is        #
#           $(LDSSLVODR) = the directory where the objects have to be put    #
#                                                                            #
#   Output: $(LDSSLVOBJ) = the final object(s) / library                     #
#           $(LDSSLVLIB) = external libraries + -L<libdirs>                  #
#           $(LDSSLVH)   = the .h files to include for BundleSolver          #
#           $(LDSSLVINC) = the -I$( BundleSolver directory )                 #
#                                                                            #
#                                VERSION 1.10                                #
#                               18 - 06 - 2020                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                               Enrico Gorgone                               #
#                          Operations Research Group                         #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I<include directories>

# define input macros for libCPLEX library makefile, then include it
# not necessary, MILPSolver does it already
#libCPLEXDIR = $(LDSSLVSDR)../extlib/
#include $(libCPLEXDIR)makefile-libCPLEX

# define input macros for libNDO library makefile, then include it
#libNDOSDR = $(LDSSLVSDR)ndosolver_fioracle_project/
#include $(libNDOSDR)lib/makefile-inc

# define input macros for SMS++ library makefile, then include it
# not necessary, MILPSolver does it already
#SMS++SDR = $(LDSSLVSDR)../SMS++/
#include $(SMS++SDR)lib/makefile-inc

# define input macros for MILPSolver complete makefile, then include it
#MILPSSDR = $(LDSSLVSDR)../MILPSolver/
#include $(MILPSSDR)/makefile-c

# include the makefile requiring all external modules in input
include $(LDSSLVSDR)/makefile

# include the makefile requiring all external modules in input
BNDSLVSDR = $(LDSSLVSDR)../bundlesolver/
include $(BNDSLVSDR)/makefile-c

# macroes to be exported- - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to MCFBkINC, MCFBkOBJ and MCFBkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
LDSSLVOBJ := $(LDSSLVOBJ) $(BNDSLVOBJ) $(SMS++OBJ)
LDSSLVINC := $(LDSSLVINC) $(BNDSLVINC) $(SMS++INC)  
LDSSLVH := $(LDSSLVH) $(BNDSLVH) 

# $(libNDOOBJ) $(libNDOINC) $(libNDOH)  $(libNDOLIB) $(MILPSOBJ) $(MILPSINC) $(MILPSLIB)

# external libreries for LagranginDualSolver
LDSSLVLIB =  $(BNDSLVLIB) $(SMS++LIB) 

############################ End of makefile #################################
