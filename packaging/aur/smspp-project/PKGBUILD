pkgver=0.7.99
pkgrel=1
_tarball=smspp-project-$pkgver.tar.gz
pkgdesc="Framework to model and solve block-structured optimization problems"
arch=('x86_64' 'aarch64')
url="https://smspp.gitlab.io/"
license=('LGPL-3.0-only')
makedepends=(
  cmake
  help2man
  boost
  eigen
  netcdf-cxx
  stopt
  libsvm
  liblinear
  cadical
  minisat
  highs
  scip
  coin-or-lemon
)
# link-time optimization of a code base this large is a memory sink
options=('!lto')
source=(
  "$_tarball::$_registry/$pkgver/$_tarball"
  "fastflow-$_ff.tar.gz::$_ffurl/$_ff.tar.gz"
)
# the tarball of the release has no top directory
noextract=("$_tarball")
sha256sums=(
  'a33859ae4ca6ca2ab9d6bfce67804e501051eae1780b4f148ef489f52978d91a'
  'fca23ce672fe12fe7cdbfa6955a982d6eb75816a00d2d97a93deba9b351f9c53'
)

prepare() {
  mkdir -p smspp-project-$pkgver
  bsdtar -xf $_tarball -C smspp-project-$pkgver
  # the settings of the umbrella for its developers give way to these
  rm -f smspp-project-$pkgver/CMakeSettings.txt
}

build() {
  # the build type None of Arch defines no NDEBUG
  CXXFLAGS+=" -DNDEBUG"
  # CPLEX, Gurobi and MOSEK are not redistributable, the C interface
  # of Clarabel and the other QP solvers are in no package; FastFlow,
  # which the core fetches at configure time, comes as a source; the
  # header of CaDiCaL is in a directory of its own
  cmake -S smspp-project-$pkgver -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_tests=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_experiments=OFF \
    -DCMAKE_SKIP_INSTALL_RPATH=ON \
    -DFETCHCONTENT_SOURCE_DIR_FASTFLOW="$srcdir/fastflow-$_ff" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_PIPS=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_Clarabel=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_quadprog=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_HPIPM=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_Torch=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_CPLEX=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_GUROBI=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_MOSEK=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_DAQP=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_qpOASES=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_proxsuite=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_piqp=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_osqp=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_qpmad=ON \
    -DHiGHS_ROOT=/usr \
    -DSCIP_ROOT=/usr \
    -DCADICAL_ROOT=/usr \
    -DMINISAT_ROOT=/usr \
    -DLIBSVM_ROOT=/usr \
    -DLIBLINEAR_ROOT=/usr \
    -DStOpt_ROOT=/usr \
    -DLEMON_ROOT=/usr \
    -DCOMBO_ROOT=OFF \
    -DRECORD_ROOT=OFF \
    -DSMSPP_EXTLIB_DEFAULTS=OFF \
    -DCADICAL_INCLUDE_DIR=/usr/include/cadical \
    -DUSE_MPI=OFF
  cmake --build build
}

# the one build of the umbrella is installed one module at a time,
# each in its package, and so are the tools; the install goes through
# DESTDIR, since the link that carries the old name of a tool is made
# of the prefix of the configure

package_libsmspp() {
  pkgdesc="SMS++: Core library of the SMS++ modelling framework"
  depends=(boost eigen netcdf-cxx)
  DESTDIR="$pkgdir" cmake --install build/SMS++
}

package_libsmspp-bkb() {
  pkgdesc="SMS++: Binary knapsack Block and its dynamic programming Solver"
  depends=(libsmspp)
  DESTDIR="$pkgdir" cmake --install build/BinaryKnapsackBlock
  rm "$pkgdir/usr/bin/bkbench"
  rmdir --ignore-fail-on-non-empty "$pkgdir/usr/bin"
}

package_libsmspp-mcf() {
  pkgdesc="SMS++: Min-cost flow Block"
  depends=(libsmspp)
  DESTDIR="$pkgdir" cmake --install build/MCFBlock
  rm "$pkgdir/usr/bin/dmx2nc4"
  rmdir --ignore-fail-on-non-empty "$pkgdir/usr/bin"
}

package_libsmspp-cflb() {
  pkgdesc="SMS++: Capacitated facility location Block"
  depends=(libsmspp-bkb libsmspp-mcf)
  DESTDIR="$pkgdir" cmake --install build/CapacitatedFacilityLocationBlock
  rm "$pkgdir/usr/bin/cfl2nc4"
  rmdir --ignore-fail-on-non-empty "$pkgdir/usr/bin"
}

