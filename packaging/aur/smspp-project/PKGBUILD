pkgbase=smspp-project
_gitlab=https://gitlab.com/api/v4/projects
_registry=$_gitlab/smspp%2Fsmspp-project/packages/generic/smspp-project
# FastFlow, which the core fetches at configure time, at the commit
# that the other packages of the project pin
_ff=d476f66ab924d8d122f54b4b90aee00ef979aea8
_ffurl=https://github.com/fastflow/fastflow/archive
pkgname=(
  libsmspp
  libsmspp-bkb
  libsmspp-mcf
