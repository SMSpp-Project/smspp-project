package_smspp-ucblock() {
  pkgdesc="SMS++: Unit Commitment solver"
  depends=(libsmspp libsmspp-ucblock libsmspp-milp)
  DESTDIR="$pkgdir" cmake --install build/tools/ucblock_solver
  DESTDIR="$srcdir/helper-nc4generator" \
    cmake --install build/UCBlock
  install -Dm755 -t "$pkgdir/usr/bin" \
    "$srcdir/helper-nc4generator/usr/bin/nc4generator"
}

