#!/usr/bin/env bash

# remember that +512 is always needed since the R3B is a MCFBlock
# solved by a MCFSolver

niter=0
# everything, comprised abstract
#wchg=1023
# everything, but not abstract
#wchg=767
# everything but fix-open & change type, comprised abstract
wchg=831
# everything but change type, comprised abstract
#wchg=895
rounds=40
maxseed=2

# ORLib - - - - - - - - - - - - - - - - - - - -

for f in ../data/txt/ORLib/*.txt; do
  for (( seed = 0 ; seed <= maxseed ; seed++ )); do

    printf "[${f} c $niter $seed $wchg $rounds]: "

    ./CFL_test ${f} c $niter $seed $wchg $rounds

    retVal=$?
    if [ $retVal -ne 0 ]; then
       exit 1
    fi

  done
done

# Yang- - - - - - - - - - - - - - - - - - - - - -

for i in 30-200 60-200 60-300 80-400; do
  for (( h = 1 ; h <= 5 ; h++ )); do
    for (( seed = 0 ; seed <= maxseed ; seed++ )); do

      f=../data/txt/Yang/${i}/${i}-${h}.txt

      printf "[${f} l $niter $seed $wchg $rounds]: "

      ./CFL_test ${f} l $niter $seed $wchg $rounds

      retVal=$?
      if [ $retVal -ne 0 ]; then
         exit 1
      fi

    done
  done
done

# TBED- - - - - - - - - - - - - - - - - - - - - -

for i in 300; do
  for (( h = 1 ; h <= 10 ; h++ )); do
    for (( seed = 0 ; seed <= maxseed ; seed++ )); do

      f=../data/txt/TBED/${i}/i${i}_${h}.txt

      printf "[${f} f $niter $seed $wchg $rounds]: "

      ./CFL_test ${f} f $niter $seed $wchg $rounds

      retVal=$?
      if [ $retVal -ne 0 ]; then
         exit 1
      fi

    done
  done
done

# end batch
